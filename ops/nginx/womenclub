server_tokens off;
limit_req_zone $binary_remote_addr zone=bloom_auth:10m rate=12r/m;
limit_req_status 429;

server {
    listen 80;
    server_name bloomclub.ru www.bloomclub.ru;

    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name app.bloomclub.ru;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bloomclub.ru www.bloomclub.ru;

    root /opt/fed_women_club_WEB/frontend/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/bloomclub.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bloomclub.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests" always;
    client_max_body_size 12m;

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health/db {
        proxy_pass http://127.0.0.1:8000/health/db;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /docs/ {
        try_files $uri =404;
    }

    # Public WEB must never expose the Browser Mobile App login-code flow.
    location = /api/v1/auth/login-code {
        return 404;
    }

    location = /api/v1/health {
        proxy_pass http://127.0.0.1:8000/api/v1/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/v1/(auth/(login|user-login|browser-token-login|password-setup/complete)|partner/(login|code-login))$ {
        limit_req zone=bloom_auth burst=8 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:8000/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name app.bloomclub.ru;

    root /opt/fed_women_club_WEB/browser-mobile-app/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/bloomclub.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bloomclub.ru/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Startup splash uses a small inline bootstrap script; unsafe-inline can be
    # removed after that script is moved to a hashed external asset.
    # Browser Mobile App embeds Yandex Maps JS API. Keep the allowlist scoped to
    # the API loader/runtime and map tile/service hosts instead of widening CSP.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://api-maps.yandex.ru https://yastatic.net; connect-src 'self' https://api-maps.yandex.ru https://*.maps.yandex.net https://*.maps.yandex.com https://*.yandex.ru; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests" always;
    client_max_body_size 12m;

    location ^~ /docs/ {
        try_files $uri =404;
    }

    location = /api/v1/health {
        proxy_pass http://127.0.0.1:8000/api/v1/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/v1/(auth/(login|user-login|login-code|browser-token-login|password-setup/complete)|partner/(login|code-login))$ {
        limit_req zone=bloom_auth burst=8 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:8000/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
